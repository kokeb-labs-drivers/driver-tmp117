/**
 * @file tmp117_version.h
 * @brief TMP117 driver version, generated by CMake from tmp117_version.h.in.
 * @copyright Copyright (c) 2026 The driver-tmp117 authors. SPDX-License-Identifier: MIT
 *
 * Do not edit the generated file: the version is set once, in cmake/tmp117_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef TMP117_VERSION_H
#define TMP117_VERSION_H

/** Major version: incompatible API changes. */
#define TMP117_VERSION_MAJOR @TMP117_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define TMP117_VERSION_MINOR @TMP117_VERSION_MINOR@
/** Patch version: fixes. */
#define TMP117_VERSION_PATCH @TMP117_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define TMP117_VERSION_STRING "@TMP117_VERSION@"

#endif // TMP117_VERSION_H
